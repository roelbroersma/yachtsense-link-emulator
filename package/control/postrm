#!/bin/sh
[ -n "${IPKG_INSTROOT:-}" ] && exit 0
[ "${PKG_UPGRADE:-0}" = '1' ] && exit 0
[ "${1:-}" = 'upgrade' ] && exit 0
# Keep the old upgrade hooks from interrupting installation requests. On actual
# removal reload routes/ACLs without restarting the web server.
timeout 3 ubus call session reload_acls >/dev/null 2>&1 || true
timeout 3 ubus send vuci.notify '{"event":"reload_routes"}' >/dev/null 2>&1 || true
exit 0
