#!/bin/sh

# Match the cleanup hooks generated by the RutOS package build system for
# packages that install rpcd ACLs plus VuCI path/menu descriptors.
# On an in-place upgrade, do not reload/remove the old UI halfway through the
# replacement; the new package's default_postinst performs the required reloads.
[ -n "${IPKG_INSTROOT:-}" ] && exit 0
[ "${PKG_UPGRADE:-0}" = "1" ] && exit 0

[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd reload >/dev/null 2>&1 || true
[ -x /etc/init.d/rpcd ] && ubus call session reload_acls >/dev/null 2>&1 || true
[ -x /etc/init.d/uhttpd ] && killall -q -1 uhttpd || true
[ -x /etc/init.d/uhttpd ] && ubus send vuci.notify '{"event": "reload_routes"}' >/dev/null 2>&1 || true
exit 0
