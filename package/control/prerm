#!/bin/sh

# This file is installed as prerm-pkg and sourced by RutOS default_prerm.
# RutOS stops/disables the init script itself; this hook only removes network
# state that was created and tracked by this package.
[ -n "${IPKG_INSTROOT:-}" ] && exit 0

STATE_FILE='/var/run/yachtsense-link-emulator.managed-ip'
if [ -r "$STATE_FILE" ]; then
	read -r managed_interface managed_address < "$STATE_FILE"
	if [ -n "$managed_interface" ] && [ -n "$managed_address" ]; then
		ip addr del "$managed_address" dev "$managed_interface" >/dev/null 2>&1 || true
	fi
	rm -f "$STATE_FILE"
fi
rm -f /var/run/yachtsense-link-emulator.runtime /var/run/yachtsense-link-emulator.runtime.tmp
exit 0
