{
  "services/yachtsense-link-emulator": {
    "description": "Read and manage YachtSense Link Emulator",
    "read": {
      "api": [
        "/yachtsense-link-emulator-v1100/status",
        "/yachtsense-link-emulator-v1100/status/",
        "/yachtsense-link-emulator-v1100/status/*",
        "/yachtsense-link-emulator-v1100/diagnostics",
        "/yachtsense-link-emulator-v1100/diagnostics/",
        "/yachtsense-link-emulator-v1100/diagnostics/*"
      ],
      "ubus": {
        "yachtsense-link-emulator": [
          "status",
          "diagnostics"
        ]
      },
      "uci": [
        "yachtsense_link_emulator"
      ]
    },
    "write": {
      "api": [
        "/yachtsense-link-emulator-v1100/actions/save",
        "/yachtsense-link-emulator-v1100/actions/save/",
        "/yachtsense-link-emulator-v1100/actions/start",
        "/yachtsense-link-emulator-v1100/actions/start/",
        "/yachtsense-link-emulator-v1100/actions/stop",
        "/yachtsense-link-emulator-v1100/actions/stop/",
        "/yachtsense-link-emulator-v1100/actions/restart",
        "/yachtsense-link-emulator-v1100/actions/restart/"
      ],
      "ubus": {
        "yachtsense-link-emulator": [
          "save",
          "start",
          "stop",
          "restart"
        ]
      },
      "uci": [
        "yachtsense_link_emulator"
      ]
    }
  }
}
