#!/bin/sh /etc/rc.common
START=97
STOP=10
USE_PROCD=1

# Follow RutOS' logical package root, including externally backed /usr/local.
PACKAGE_ROOT="$(awk '$1 == "dest" && $2 == "root" { print $3; exit }' /etc/opkg.conf 2>/dev/null)"
PACKAGE_ROOT="${PACKAGE_ROOT%/}"
PROG="${PACKAGE_ROOT}/usr/sbin/yachtsense-link-emulator"
SELF="${PACKAGE_ROOT}/etc/init.d/yachtsense-link-emulator"

# Absolute links also work when custom packages live under /usr/local.
enable() {
  "$PROG" --is-enabled >/dev/null 2>&1 || { disable; return 0; }
  mkdir -p /etc/rc.d || return 1
  ln -sf "$SELF" "/etc/rc.d/S${START}yachtsense-link-emulator" || return 1
  ln -sf "$SELF" "/etc/rc.d/K${STOP}yachtsense-link-emulator"
}
disable() {
  rm -f "/etc/rc.d/S${START}yachtsense-link-emulator" "/etc/rc.d/K${STOP}yachtsense-link-emulator"
}
start_service() {
  [ -x "$PROG" ] || return 1
  "$PROG" --is-enabled >/dev/null 2>&1 || return 0
  procd_open_instance
  procd_set_param command "$PROG" --daemon
  procd_set_param respawn 30 10 0
  procd_set_param term_timeout 7
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
# The daemon performs only explicitly requested address management. The init
# script never deletes an address, including on failed starts or upgrades.
stop_service() { return 0; }
service_triggers() { return 0; }
