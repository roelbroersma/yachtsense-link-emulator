#!/bin/sh /etc/rc.common

# Start after normal network bridges have been created by RutOS.
START=97
STOP=10
USE_PROCD=1

# Package paths and the state file that records only an address added by us.
PROG='/usr/sbin/yachtsense-link-emulator'
STATE_FILE='/var/run/yachtsense-link-emulator.managed-ip'
LOG_TAG='yachtsense-link-emulator'
UCI_CONFIG='yachtsense_link_emulator'

# Load the single named UCI section and apply clean-install defaults.
load_settings() {
	config_load "$UCI_CONFIG"
	config_get_bool enabled main enabled 0
	config_get_bool mdns_enabled main mdns_enabled 1
	config_get_bool web_enabled main web_enabled 1
	config_get interface main interface 'br-lan'
	config_get_bool manage_ip main manage_ip 1
	config_get ipaddr main ipaddr '198.18.0.1'
	config_get prefix main prefix '21'
	config_get_bool remove_ip_on_stop main remove_ip_on_stop 1
	config_get serial main serial 'RUTX001'
	config_get version main version 'V142.242.530'
	config_get hostname main hostname 'yachtsense-link'
	config_get instance main instance 'YachtSense Link Settings'
	config_get ttl main ttl '120'
	config_get health_port main health_port '7777'
}

# Return success when an exact IPv4 address/prefix exists on a Linux device.
address_present() {
	local device="$1"
	local address="$2"
	ip -o -4 addr show dev "$device" 2>/dev/null | grep -Fq "inet $address "
}

# Remove the address recorded in STATE_FILE. The force argument is used during
# a restart so a changed interface/address can be reapplied without leaving the
# previous managed address behind.
remove_managed_address() {
	local force="${1:-0}"
	local old_interface old_address

	[ -r "$STATE_FILE" ] || return 0
	[ "$force" -eq 1 ] || [ "$remove_ip_on_stop" -eq 1 ] || return 0

	read -r old_interface old_address < "$STATE_FILE"
	if [ -n "$old_interface" ] && [ -n "$old_address" ] && address_present "$old_interface" "$old_address"; then
		ip addr del "$old_address" dev "$old_interface" 2>/dev/null || true
		logger -t "$LOG_TAG" "Removed managed address $old_address from $old_interface"
	fi

	rm -f "$STATE_FILE"
}

# Add the configured address only when management is enabled. Existing user-
# owned addresses are never written to STATE_FILE and therefore never removed.
add_managed_address() {
	local address="${ipaddr}/${prefix}"

	[ "$manage_ip" -eq 1 ] || return 0
	ip link show dev "$interface" >/dev/null 2>&1 || {
		logger -t "$LOG_TAG" "Interface $interface does not exist"
		return 1
	}

	if address_present "$interface" "$address"; then
		logger -t "$LOG_TAG" "Address $address is already present on $interface"
		return 0
	fi

	ip addr add "$address" dev "$interface" || {
		logger -t "$LOG_TAG" "Could not add $address to $interface"
		return 1
	}

	printf '%s %s\n' "$interface" "$address" > "$STATE_FILE"
	logger -t "$LOG_TAG" "Added managed address $address to $interface"
}

# Start the native responder under procd and export all UCI values as a small,
# explicit environment contract. The daemon itself contains no UCI dependency.
start_service() {
	load_settings

	[ "$enabled" -eq 1 ] || {
		logger -t "$LOG_TAG" "Service is disabled in configuration"
		return 0
	}
	[ "$mdns_enabled" -eq 1 ] || [ "$web_enabled" -eq 1 ] || {
		logger -t "$LOG_TAG" "mDNS and HTTP service are both disabled"
		return 0
	}
	[ -x "$PROG" ] || {
		logger -t "$LOG_TAG" "Executable $PROG is missing"
		return 1
	}

	# A restart always clears a previously managed address before applying the
	# current interface and address settings.
	remove_managed_address 1
	add_managed_address || return 1

	logger -t "$LOG_TAG" "Starting on $interface with ${ipaddr}/${prefix}"
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		YSL_IFACE="$interface" \
		YSL_IP="$ipaddr" \
		YSL_SERIAL="$serial" \
		YSL_VERSION="$version" \
		YSL_HOSTNAME="$hostname" \
		YSL_INSTANCE="$instance" \
		YSL_HEALTH_PORT="$health_port" \
		YSL_TTL="$ttl" \
		YSL_MDNS_ENABLED="$mdns_enabled" \
		YSL_WEB_ENABLED="$web_enabled"

	# Respawn after unexpected exits, while avoiding a tight crash loop.
	procd_set_param respawn 5 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# procd terminates the native process; only package-managed network state needs
# explicit cleanup here.
stop_service() {
	load_settings
	remove_managed_address 0
	logger -t "$LOG_TAG" "Service stopped"
}

# A full restart is required because multicast membership and bind addresses
# cannot be changed safely inside a running process.
reload_service() {
	stop
	start
}

# Reload the service when this UCI package is committed outside the VuCI page.
service_triggers() {
	procd_add_reload_trigger "$UCI_CONFIG"
}
