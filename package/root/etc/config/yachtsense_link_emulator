# YachtSense Link Emulator. Observe existing interfaces by default.
config emulator 'main'
 option enabled '0'
 option mdns_enabled '1'
 option web_enabled '1'
 option raynet_mode 'auto'
 option app_mode 'auto'
 option axiom_interface 'br-lan'
 list remote_interface 'br-lan'
 option discovery_mode 'auto'
 option manage_ip '0'
 option ipaddr '198.18.0.1'
 option prefix '21'
 option remove_ip_on_stop '0'
 option serial 'AF002A4'
 option version 'V142.242.530'
 option hostname 'yachtsense-main'
 option instance 'yachtsense-main Settings'
 option ttl '120'
 option health_port '7777'
 option log_level 'info'
 option log_lines '40'

	option dashboard_enabled '1'
	option dashboard_port '8088'
	option dashboard_allow_all '1'
	option dashboard_allowed_cidrs '192.168.4.0/24'
